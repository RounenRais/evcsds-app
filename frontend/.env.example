# Bu dosyayı .env.local olarak kopyalayıp doldurun. .env.local depoya girmez.

# Tarayıcının katalog ve öneri uçları için kullanacağı adres.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Görsel analiz vekilinin kullandığı adres (yalnız sunucu tarafında okunur).
EVCSDS_API_URL=http://localhost:8000

# Görsel analiz API anahtarı. Yalnız sunucuda kalır, tarayıcıya gönderilmez.
# Üretmek için backend'de EVCSDS_ADMIN_KEY tanımlayıp /keys/generate çağırın.
EVCSDS_API_KEY=
